# =========================================================
# EnderChest Environment Configuration
# =========================================================

# GEMINI_API_KEY: Platform AI key (Server-side)
GEMINI_API_KEY=

# APP_URL: Base URL of your deployed application
APP_URL=http://localhost:3000

# Supabase Credentials (Server-side only)
# SUPABASE_URL: Project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY: The secret service_role key (starts with ey...)
SUPABASE_SERVICE_ROLE_KEY=

# Server Session Security: Secret string for signing room session tokens
SESSION_SECRET=

# Master Google Drive Central Vault (5TB Backend Storage)
# When set, all EnderChest rooms automatically route file uploads/downloads
# to this central Google Drive account with zero user login/OAuth required.
MASTER_GOOGLE_DRIVE_REFRESH_TOKEN=
MASTER_GOOGLE_DRIVE_ACCESS_TOKEN=
MASTER_GOOGLE_DRIVE_EMAIL=unitedsatesrbd404@gmail.com

# Google Drive OAuth (Server-side)
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Matching redirect URI (e.g. https://your-domain.run.app/api/drive/callback)
GOOGLE_REDIRECT_URI=


